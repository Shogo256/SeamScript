{
  "name": "@seamscript/ts-plugin",
  "version": "0.1.0",
  "description": "TypeScript language service plugin for SeamScript: completions, hover, navigation, rename and SeamScript's diagnostics for .seam.ts files in any editor that runs tsserver",
  "keywords": [
    "seamscript",
    "typescript",
    "tsserver-plugin",
    "language-service",
    "volar"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shogo256/SeamScript.git",
    "directory": "packages/ts-plugin"
  },
  "homepage": "https://github.com/Shogo256/SeamScript/tree/main/packages/ts-plugin#readme",
  "bugs": "https://github.com/Shogo256/SeamScript/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@seamscript/compiler": "0.1.0",
    "@types/node": "24.19.2",
    "@volar/language-core": "2.4.28",
    "@volar/typescript": "2.4.28",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
