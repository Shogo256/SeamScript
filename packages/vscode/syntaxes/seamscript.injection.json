{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "seamscript.injection",
  "comment": "SeamScript's syntax on top of TypeScript's grammar (.seam.ts and .seam.tsx are TypeScript files to VS Code). Recognized in the same shapes as the compiler's parser: the keyword followed on the same line by a name or literal, never `as`, `satisfies` or `of`.",
  "injectionSelector": "L:source.ts -comment -string, L:source.tsx -comment -string",
  "patterns": [
    {
      "include": "#boundary"
    },
    {
      "include": "#decode"
    },
    {
      "include": "#latest"
    }
  ],
  "repository": {
    "boundary": {
      "comment": "boundary Name { field: Type; ... }  or  boundary Name = A | B",
      "begin": "(?<![\\w$.])(boundary)\\s+([A-Za-z_$][\\w$]*)(?=\\s*[{=])",
      "beginCaptures": {
        "1": {
          "name": "storage.type.boundary.seamscript"
        },
        "2": {
          "name": "entity.name.type.boundary.seamscript"
        }
      },
      "end": "(?<=\\})|(?=;)|$",
      "patterns": [
        {
          "match": "=",
          "name": "keyword.operator.assignment.ts"
        },
        {
          "include": "#boundary-body"
        },
        {
          "include": "#constraint"
        },
        {
          "include": "source.ts#type"
        }
      ]
    },
    "decode": {
      "comment": "decode Type from value: the target is a type, and `from` ends it. A parenthesized target counts only when `from` follows on the line, as in the parser (otherwise it is a call). `from json` marks JSON text, again as in the parser: only when a name or a string follows.",
      "begin": "(?<![\\w$.])(decode)(?=\\s+(?:(?!(?:as|satisfies|of|from)(?![\\w$]))[\\w$\"'\\[{-]|\\((?=.*(?<![\\w$.])from(?![\\w$]))))",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.expression.decode.seamscript"
        }
      },
      "end": "(?<![\\w$.])(from)(?![\\w$])(?:\\s+(json)(?=\\s+(?:(?!(?:as|satisfies|of|in|instanceof)(?![\\w$]))[\\w$]|[\"'])))?|$",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.expression.from.seamscript"
        },
        "2": {
          "name": "keyword.operator.expression.json.seamscript"
        }
      },
      "patterns": [
        {
          "include": "source.ts#type"
        }
      ]
    },
    "latest": {
      "comment": "[export] latest async function name(...): `export` is taken here too, or TypeScript's grammar would read `latest` as the name being exported",
      "match": "(?<![\\w$.])(?:(export)\\s+)?(latest)(?=\\s+async\\s+function(?![\\w$]))",
      "captures": {
        "1": {
          "name": "keyword.control.export.ts"
        },
        "2": {
          "name": "storage.modifier.latest.seamscript"
        }
      }
    },
    "boundary-body": {
      "comment": "The fields of an object boundary, whose types may be followed by constraints.",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.ts"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.ts"
        }
      },
      "name": "meta.object.type.ts",
      "patterns": [
        {
          "include": "source.ts#comment"
        },
        {
          "include": "#boundary-field"
        },
        {
          "include": "source.ts#punctuation-comma"
        },
        {
          "include": "source.ts#punctuation-semicolon"
        }
      ]
    },
    "boundary-field": {
      "comment": "name?: Type constraints",
      "begin": "([A-Za-z_$][\\w$]*|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*')\\s*(\\?)?\\s*(:)",
      "beginCaptures": {
        "1": {
          "name": "variable.object.property.ts"
        },
        "2": {
          "name": "keyword.operator.optional.ts"
        },
        "3": {
          "name": "keyword.operator.type.annotation.ts"
        }
      },
      "end": "(?=[,;}]|//|/\\*)|$",
      "name": "meta.type.annotation.ts",
      "patterns": [
        {
          "include": "#constraint"
        },
        {
          "include": "source.ts#type"
        }
      ]
    },
    "constraint": {
      "comment": "matches /re/, minLength N, maxLength N, in A..B",
      "patterns": [
        {
          "match": "(?<![\\w$.])(matches)\\s+(/(?:[^/\\\\\\[\\n]|\\\\.|\\[(?:[^\\]\\\\\\n]|\\\\.)*\\])+/[dgimsuvy]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.constraint.seamscript"
            },
            "2": {
              "name": "string.regexp.ts"
            }
          }
        },
        {
          "match": "(?<![\\w$.])(minLength|maxLength)\\s+(\\d[\\d_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.constraint.seamscript"
            },
            "2": {
              "name": "constant.numeric.decimal.ts"
            }
          }
        },
        {
          "match": "(?<![\\w$.])(in)\\s+(-?\\s*\\d[\\d_]*(?:\\.\\d[\\d_]*)?)\\s*(\\.\\.)\\s*(-?\\s*\\d[\\d_]*(?:\\.\\d[\\d_]*)?)",
          "captures": {
            "1": {
              "name": "keyword.operator.constraint.seamscript"
            },
            "2": {
              "name": "constant.numeric.decimal.ts"
            },
            "3": {
              "name": "keyword.operator.range.seamscript"
            },
            "4": {
              "name": "constant.numeric.decimal.ts"
            }
          }
        }
      ]
    }
  }
}
