import { Int64 } from "@seamscript/runtime";
import { useState } from "react";
import type { CoreState } from "../core-state.seam";
import type { Feed } from "../feed.seam";
import { FeedContext } from "./hooks.seam";
import { OrderEntry } from "./OrderEntry.seam";
import { Orders } from "./Orders.seam";
import { PriceBoard } from "./PriceBoard.seam";
import { Problems } from "./Problems.seam";
import { StatusBar } from "./StatusBar.seam";

export function App({ feed, core }: { feed: Feed; core: CoreState }) {
  const [instrumentId, setInstrumentId] = useState<Int64 | null>(null);
  if (core.kind === "failed") {
    return (
      <div className="fatal" data-testid="fatal">
        <h1>Can't start</h1>
        <p>The WASM core that handles text failed to load. The app stops here so that text doesn't behave differently from one environment to another.</p>
        <pre>{core.message}</pre>
      </div>
    );
  }
  return (
    <FeedContext.Provider value={feed}>
      <div className="app">
        <StatusBar core={core} />
        <main>
          <PriceBoard selected={instrumentId} onSelect={setInstrumentId} />
          <div className="side">
            <OrderEntry instrumentId={instrumentId} onSelect={setInstrumentId} />
            <Problems />
          </div>
          <Orders />
        </main>
      </div>
    </FeedContext.Provider>
  );
}
