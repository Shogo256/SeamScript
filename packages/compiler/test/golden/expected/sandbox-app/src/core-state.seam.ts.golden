import "@seamscript/core";
import { Text } from "@seamscript/runtime";
export type CoreState =
  /** Production: the WASM core is installed. */
  | { readonly kind: "wasm"; readonly unicode: string }
  /** Development: Text runs on the browser's own ICU. */
  | { readonly kind: "host" }
  /** Production with @seamscript/core/deferred, before Text.ready settles. */
  | { readonly kind: "loading" }
  /** Production, but the core could not load (a CSP without 'wasm-unsafe-eval'). */
  | { readonly kind: "failed"; readonly message: string };

export function coreState(): CoreState {
  switch (Text.status) {
    case "core":
      return { kind: "wasm", unicode: Text.unicodeVersion ?? "?" };
    case "host":
      return { kind: "host" };
    case "loading":
      return { kind: "loading" };
    case "failed":
      return {
        kind: "failed",
        message: "Couldn't load @seamscript/core. Check that the page's Content-Security-Policy allows 'wasm-unsafe-eval'.",
      };
  }
}
