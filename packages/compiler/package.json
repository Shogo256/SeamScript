{
  "name": "@seamscript/compiler",
  "version": "0.0.0",
  "description": "SeamScript compiler: expands .seam.ts into plain TypeScript and checks boundaries",
  "type": "module",
  "bin": {
    "seamc": "./bin/seamc.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/types": "8.0.6",
    "@jridgewell/trace-mapping": "0.3.31",
    "@seamscript/parser": "0.0.0",
    "magic-string": "1.4.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@seamscript/runtime": "0.0.0",
    "@types/node": "24.19.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
