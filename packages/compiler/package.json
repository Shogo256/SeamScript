{
  "name": "@seamscript/compiler",
  "version": "0.1.1",
  "description": "SeamScript compiler: expands .seam.ts into plain TypeScript and checks boundaries",
  "keywords": [
    "seamscript",
    "typescript",
    "compiler",
    "vite-plugin",
    "unplugin",
    "esbuild-plugin",
    "rollup-plugin",
    "webpack-plugin"
  ],
  "type": "module",
  "bin": {
    "seamc": "./bin/seamc.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./checker": {
      "types": "./dist/checker.d.ts",
      "default": "./dist/checker.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "default": "./dist/transform.js"
    },
    "./mappings": {
      "types": "./dist/mappings.d.ts",
      "default": "./dist/mappings.js"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.ts",
      "default": "./dist/unplugin.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shogo256/SeamScript.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/Shogo256/SeamScript/tree/main/packages/compiler#readme",
  "bugs": "https://github.com/Shogo256/SeamScript/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/types": "8.0.6",
    "@jridgewell/trace-mapping": "0.3.31",
    "@seamscript/parser": "0.1.1",
    "magic-string": "1.4.3",
    "typescript": "5.9.3",
    "unplugin": "3.4.0"
  },
  "devDependencies": {
    "@seamscript/runtime": "0.1.1",
    "@types/node": "24.19.2",
    "rollup": "4.64.6",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "webpack": "5.111.1"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
