{
  "name": "@seamscript/core",
  "version": "0.1.0",
  "description": "WASM core for SeamScript's Text: grapheme segmentation and normalization at a pinned Unicode version",
  "keywords": [
    "seamscript",
    "unicode",
    "grapheme",
    "normalization",
    "wasm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "default": "./dist/load.js"
    },
    "./deferred": {
      "types": "./dist/deferred.d.ts",
      "default": "./dist/deferred.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "cargo test -q && sh scripts/fetch-ucd.sh && tsc -p tsconfig.json --noEmit && vitest run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shogo256/SeamScript.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Shogo256/SeamScript/tree/main/packages/core#readme",
  "bugs": "https://github.com/Shogo256/SeamScript/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@seamscript/runtime": "0.1.0",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@seamscript/runtime": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
