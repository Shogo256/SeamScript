{
  "name": "@seamscript/react",
  "version": "0.1.0",
  "description": "React bindings for SeamScript: useFork gives a component its own line of a latest function, cancelled on unmount",
  "keywords": [
    "seamscript",
    "react",
    "hooks",
    "latest",
    "race-condition"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shogo256/SeamScript.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Shogo256/SeamScript/tree/main/packages/react#readme",
  "bugs": "https://github.com/Shogo256/SeamScript/issues",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@seamscript/runtime": "0.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@seamscript/runtime": "0.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
